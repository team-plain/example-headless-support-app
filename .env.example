# Copy this file to .env.local and fill it in.
#
# Vite bundles every VITE_ variable into the JavaScript sent to the browser,
# so everything here is public. Never put a client secret in this file.

# Client ID of your Plain OAuth app: Plain → Settings → OAuth applications.
VITE_PLAIN_OAUTH_CLIENT_ID=

# Optional. Plain's GraphQL API. Defaults to https://core-api.uk.plain.com/graphql/v1
VITE_PLAIN_API_URL=

# Optional. Plain's OAuth authorization server. Defaults to https://signin.auth.plain.com
VITE_PLAIN_AUTH_URL=

# Optional. Plain's web app, used for "Open in Plain" links. Defaults to https://app.plain.com
VITE_PLAIN_APP_URL=
